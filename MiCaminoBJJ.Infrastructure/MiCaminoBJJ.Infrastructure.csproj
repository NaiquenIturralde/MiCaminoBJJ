<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\MiCaminoBJJ.Core\MiCaminoBJJ.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Permite a los tests de integración verificar internos (p. ej. AliasService.IsUniqueConstraintViolation). -->
    <InternalsVisibleTo Include="MiCaminoBJJ.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />

    <!-- Seguridad: sobreescribe la 2.1.11 (transitiva de EF Core Sqlite) que empaqueta SQLite vulnerable a CVE-2025-6965 (GHSA-2m69-gcr7-jv3q).
         2.1.12+ incluye SQLite 3.50.2+ (2.1.14 incluye 3.53.3). Se mantiene la rama 2.1.x por compatibilidad con EF Core 10. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.14" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
