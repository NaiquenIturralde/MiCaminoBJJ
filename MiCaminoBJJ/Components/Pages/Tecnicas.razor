@page "/tecnicas"
@inject ISessionService SessionService
@inject ITechniqueService TechniqueService
@inject ITechniqueSearchService SearchService
@inject NavigationManager Navigation
@inject ISavedTechniqueService SavedTechniqueService

@if (_isLoading)
{
    <LoadingSpinner Message="Cargando técnicas..." />
}
else if (_hasError)
{
    <ErrorState Title="Algo salió mal" Message="@_errorMessage" ShowRetry="true" Retry="LoadData" />
}
else
{
    <div class="techniques-page">
        @* Header *@
        <div class="techniques-header">
            <div class="techniques-header-top">
                <h1>Técnicas 📚</h1>
                <a href="/mis-guardadas" class="btn btn-ghost btn-small save-link">
                    ★ Mis Favoritas
                </a>
            </div>
            <p class="text-muted">@_filteredTechniques.Count técnicas disponibles</p>
        </div>

        @* Búsqueda *@
        <div class="techniques-search">
            <input type="text" class="form-control" placeholder="Buscar técnica..." @bind="_searchTerm"
                   @bind:event="oninput" @onkeydown="OnSearchKeyDown" />
        </div>

        @* Filtros *@
        <div class="techniques-filters">
            <select class="form-control filter-select" @onchange="OnBeltFilterChanged">
                <option value="">Todos los cinturones</option>
                @foreach (var belt in _belts)
                {
                    <option value="@belt.Id">@belt.Name</option>
                }
            </select>

            <select class="form-control filter-select" @onchange="OnCategoryFilterChanged">
                <option value="">Todas las categorías</option>
                @foreach (var cat in _categories)
                {
                    <option value="@cat.Id">@cat.Name</option>
                }
            </select>

            <select class="form-control filter-select" @onchange="OnPositionFilterChanged">
                <option value="">Todas las posiciones</option>
                @foreach (var pos in _positions)
                {
                    <option value="@pos.Id">@pos.Name</option>
                }
            </select>
        </div>

        @* Botón limpiar filtros *@
        @if (_hasActiveFilters)
        {
            <div class="techniques-clear">
                <button class="btn btn-ghost btn-small" @onclick="ClearFilters">
                    ✕ Limpiar filtros
                </button>
            </div>
        }

        @if (!string.IsNullOrEmpty(_feedbackMessage))
        {
            <div class="alert alert-success" role="status" aria-live="polite">@_feedbackMessage</div>
        }
        @if (!string.IsNullOrEmpty(_feedbackError))
        {
            <div class="alert alert-danger" role="alert" aria-live="assertive">@_feedbackError</div>
        }

        @* Listado *@
        @if (_filteredTechniques.Count == 0)
        {
            @if (_hasActiveFilters)
            {
                <EmptyState Icon="🔍" Title="Sin resultados" Description="No se encontraron técnicas con esos filtros." />
            }
            else
            {
                <EmptyState Icon="📚" Title="Sin técnicas" Description="Aún no hay técnicas disponibles en la biblioteca." />
            }
        }
        else
        {
            <div class="techniques-grid">
                @foreach (var technique in _filteredTechniques)
                {
                    var isFavorite = _favoriteEntryIds.ContainsKey(technique.Id);
                    <div class="technique-card-wrap">
                        <a href="/tecnicas/@technique.Id" class="technique-card">
                            <div class="technique-card-image">
                                <span class="technique-card-image-placeholder">🥋</span>
                            </div>
                            <div class="technique-card-content">
                                <h3 class="technique-card-name">@technique.Name</h3>
                                <p class="technique-card-description">@technique.Description</p>
                                <div class="technique-card-meta">
                                    <span class="badge badge-gold">@technique.Belt.Name</span>
                                    <span class="badge badge-surface">@technique.Category.Name</span>
                                    <span class="badge badge-surface">@technique.Position.Name</span>
                                </div>
                            </div>
                        </a>
                        <button type="button" class="technique-fav-btn @(isFavorite ? "is-active" : "")"
                                aria-label="@FavoriteLabel(isFavorite)" title="@FavoriteLabel(isFavorite)"
                                aria-pressed="@(isFavorite ? "true" : "false")" @onclick="() => ToggleFavoriteAsync(technique.Id)">
                            <svg viewBox="0 0 24 24" width="20" height="20" fill="@(isFavorite ? "currentColor" : "none")"
                                 stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                                 aria-hidden="true">
                                <polygon
                                points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2" />
                            </svg>
                        </button>
                    </div>
                }
            </div>
        }
    </div>
}

@code {
    private List<Technique> _allTechniques = new();
    private List<Technique> _filteredTechniques = new();
    private List<Belt> _belts = new();
    private List<TechniqueCategory> _categories = new();
    private List<Position> _positions = new();
    private Dictionary<int, int> _favoriteEntryIds = new();
    private readonly HashSet<int> _favoriteBusyIds = new();
    private string _searchTerm = string.Empty;
    private int? _selectedBeltId;
    private int? _selectedCategoryId;
    private int? _selectedPositionId;

    private bool _isLoading = true;
    private bool _hasError = false;
    private string _errorMessage = string.Empty;
    private string _feedbackMessage = string.Empty;
    private string _feedbackError = string.Empty;

    private bool _hasActiveFilters =>
        !string.IsNullOrWhiteSpace(_searchTerm) ||
        _selectedBeltId.HasValue ||
        _selectedCategoryId.HasValue ||
        _selectedPositionId.HasValue;

    protected override async Task OnInitializedAsync()
    {
        if (!await SessionService.IsAuthenticatedAsync())
        {
            Navigation.NavigateTo("/login");
            return;
        }

        await LoadData();
    }

    private async Task LoadData()
    {
        _isLoading = true;
        _hasError = false;
        StateHasChanged();

        try
        {
            // Load complete list for filter options
            _allTechniques = await TechniqueService.GetAllAsync();

            // Extract unique filter values from the complete list
            _belts = _allTechniques
                .Select(t => t.Belt)
                .GroupBy(b => b.Id)
                .Select(g => g.First())
                .OrderBy(b => b.DisplayOrder)
                .ToList();

            _categories = _allTechniques
                .Select(t => t.Category)
                .GroupBy(c => c.Id)
                .Select(g => g.First())
                .OrderBy(c => c.DisplayOrder)
                .ToList();

            _positions = _allTechniques
                .Select(t => t.Position)
                .GroupBy(p => p.Id)
                .Select(g => g.First())
                .OrderBy(p => p.DisplayOrder)
                .ToList();

            // Show all techniques initially
            _filteredTechniques = _allTechniques;

            await LoadFavoritesAsync();
        }
        catch (Exception)
        {
            _hasError = true;
            _errorMessage = "No se pudieron cargar las técnicas.";
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadFavoritesAsync()
    {
        try
        {
            var userId = await SessionService.GetCurrentUserIdAsync();
            if (!userId.HasValue)
            {
                _favoriteEntryIds = new();
                return;
            }

            var saved = await SavedTechniqueService.GetByUserAsync(userId.Value);
            _favoriteEntryIds = saved
                .Where(s => s.SavedType == SavedType.Favorite)
                .ToDictionary(s => s.TechniqueId, s => s.Id);
        }
        catch (Exception)
        {
            _favoriteEntryIds = new();
        }
    }

    private async Task ApplyFilters()
    {
        try
        {
            var filter = new TechniqueSearchFilter
            {
                SearchTerm = string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm.Trim(),
                BeltId = _selectedBeltId,
                CategoryId = _selectedCategoryId,
                PositionId = _selectedPositionId
            };

            // If no filters active, show full list
            if (filter.SearchTerm == null && !filter.BeltId.HasValue && !filter.CategoryId.HasValue && !filter.PositionId.HasValue)
            {
                _filteredTechniques = _allTechniques;
            }
            else
            {
                _filteredTechniques = await SearchService.SearchAsync(filter);
            }
        }
        catch (Exception)
        {
            _hasError = true;
            _errorMessage = "Error al filtrar las técnicas.";
        }

        StateHasChanged();
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await ApplyFilters();
        }
    }

    private async Task OnBeltFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _selectedBeltId = string.IsNullOrEmpty(value) ? null : int.Parse(value);
        await ApplyFilters();
    }

    private async Task OnCategoryFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _selectedCategoryId = string.IsNullOrEmpty(value) ? null : int.Parse(value);
        await ApplyFilters();
    }

    private async Task OnPositionFilterChanged(ChangeEventArgs e)
    {
        var value = e.Value?.ToString();
        _selectedPositionId = string.IsNullOrEmpty(value) ? null : int.Parse(value);
        await ApplyFilters();
    }

    private async Task ToggleFavoriteAsync(int techniqueId)
    {
        if (_favoriteBusyIds.Contains(techniqueId)) return;

        var userId = await SessionService.GetCurrentUserIdAsync();
        if (!userId.HasValue)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        _favoriteBusyIds.Add(techniqueId);
        _feedbackMessage = string.Empty;
        _feedbackError = string.Empty;
        try
        {
            if (_favoriteEntryIds.TryGetValue(techniqueId, out var savedId))
            {
                await SavedTechniqueService.RemoveAsync(savedId);
                _favoriteEntryIds.Remove(techniqueId);
                _feedbackMessage = "Técnica quitada de tus favoritas.";
            }
            else
            {
                var saved = await SavedTechniqueService.SaveAsync(userId.Value, techniqueId, SavedType.Favorite);
                _favoriteEntryIds[techniqueId] = saved.Id;
                _feedbackMessage = "Técnica agregada a tus favoritas.";
            }
        }
        catch (Exception)
        {
            // Sin cambios visuales si falla la operación.
            _feedbackError = "No se pudo actualizar tus favoritas. Intentá nuevamente.";
        }
        finally
        {
            _favoriteBusyIds.Remove(techniqueId);
            StateHasChanged();
        }
    }

    private static string FavoriteLabel(bool isFavorite) =>
        isFavorite ? "Quitar de favoritos" : "Agregar a favoritos";

    private async Task ClearFilters()
    {
        _searchTerm = string.Empty;
        _selectedBeltId = null;
        _selectedCategoryId = null;
        _selectedPositionId = null;
        _filteredTechniques = _allTechniques;
        StateHasChanged();
    }
}
