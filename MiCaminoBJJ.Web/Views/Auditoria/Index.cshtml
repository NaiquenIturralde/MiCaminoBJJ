@using MiCaminoBJJ.Web.ViewModels.Admin
@model AuditoriaIndexViewModel
<partial name="_EstilosAdmin" />

<section class="mccj-page-header">
    <div class="container py-4 py-md-5">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3">
            <div>
                <span class="mccj-eyebrow">Administración</span>
                <h1 class="mccj-hero-title">Auditoría</h1>
                <p class="mccj-hero-description">
                    Registro de las operaciones administrativas sobre las técnicas:
                    quién las realizó, qué cambió y cuándo ocurrió.
                </p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-gold" href="@Model.UrlDescargarPdf" download>
                    Descargar PDF
                </a>
                <a class="btn btn-outline-light" href="/AdminTecnicas">Volver al panel</a>
            </div>
        </div>
    </div>
</section>

<section class="container mt-4">
    <form method="get" action="/Auditoria" class="mccj-filters" aria-label="Filtrar registros de auditoría">
        <div class="row g-3 align-items-end">
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="accion" class="form-label">Operación</label>
                <select class="form-select" id="accion" name="accion">
                    <option value="">Todas</option>
                    @foreach (var opcion in Model.Acciones)
                    {
                        <option value="@opcion.Valor"
                                selected="@(string.Equals(Model.AccionSeleccionada, opcion.Valor, StringComparison.OrdinalIgnoreCase))">
                            @opcion.Texto
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <label for="entidad" class="form-label">Entidad afectada</label>
                <select class="form-select" id="entidad" name="entidad">
                    <option value="">Todas</option>
                    @foreach (var opcion in Model.Entidades)
                    {
                        <option value="@opcion.Valor"
                                selected="@(string.Equals(Model.EntidadSeleccionada, opcion.Valor, StringComparison.Ordinal))">
                            @opcion.Texto
                        </option>
                    }
                </select>
            </div>
            <div class="col-12 col-sm-6 col-lg-2">
                <label for="usuario" class="form-label">Usuario</label>
                <input type="search" class="form-control" id="usuario" name="usuario" value="@Model.Usuario"
                       placeholder="Nombre o correo" />
            </div>
            <div class="col-6 col-sm-3 col-lg-2">
                <label for="desde" class="form-label">Desde</label>
                <input type="date" class="form-control" id="desde" name="desde"
                       value="@(Model.Desde?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-6 col-sm-3 col-lg-2">
                <label for="hasta" class="form-label">Hasta</label>
                <input type="date" class="form-control" id="hasta" name="hasta"
                       value="@(Model.Hasta?.ToString("yyyy-MM-dd"))" />
            </div>
            <div class="col-12 col-lg-12 d-flex gap-2">
                <button type="submit" class="btn btn-gold">Filtrar</button>
                <a class="btn btn-outline-light" href="/Auditoria">Limpiar filtros</a>
                <a class="btn btn-outline-light" href="@Model.UrlDescargarPdf" download>
                    Descargar PDF
                </a>
            </div>
        </div>
    </form>

    <div class="mccj-results-bar mt-4 mb-3">
        <p class="mccj-results-count" role="status">
            @Model.TotalRegistros @(Model.TotalRegistros == 1 ? "registro de auditoría" : "registros de auditoría")
        </p>
        @if (Model.TieneFiltros)
        {
            <a class="mccj-clear-link" href="/Auditoria">Quitar filtros</a>
        }
    </div>

    @if (!Model.HayRegistros)
    {
        <div class="mccj-card mccj-empty text-center">
            <div class="mccj-card-icon" aria-hidden="true">📋</div>
            <h2 class="h5">No hay registros de auditoría</h2>
            <p>
                Todavía no hay operaciones administrativas registradas con los criterios
                seleccionados. Cuando el administrador cree, modifique o desactive una técnica,
                la operación queda registrada en esta pantalla.
            </p>
            <a href="/Auditoria" class="btn btn-gold">Ver todos los registros</a>
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table mccj-admin-table align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col">Fecha y hora</th>
                        <th scope="col">Usuario</th>
                        <th scope="col">Operación</th>
                        <th scope="col">Entidad afectada</th>
                        <th scope="col">Identificador</th>
                        <th scope="col">Resultado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var fila in Model.Registros)
                    {
                        <tr>
                            <td>@fila.Fecha</td>
                            <td>
                                <span class="mccj-admin-name">@fila.Usuario</span>
                            </td>
                            <td>@fila.Operacion</td>
                            <td>
                                <span class="mccj-admin-sub">@fila.Entidad</span>
                            </td>
                            <td>@fila.EntidadId</td>
                            <td>
                                @if (fila.EsExitoso)
                                {
                                    <span class="badge mccj-badge-off">@fila.Resultado</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">@fila.Resultado</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (Model.TotalPaginas > 1)
        {
            <nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginación de auditoría">
                <a class="btn btn-outline-light @(Model.HayPaginaAnterior ? string.Empty : "disabled")"
                   href="@($"/Auditoria{Model.QueryStringPagina(Model.Pagina - 1)}")">Anterior</a>
                <span class="mccj-admin-sub">Página @Model.Pagina de @Model.TotalPaginas</span>
                <a class="btn btn-outline-light @(Model.HayPaginaSiguiente ? string.Empty : "disabled")"
                   href="@($"/Auditoria{Model.QueryStringPagina(Model.Pagina + 1)}")">Siguiente</a>
            </nav>
        }
    }
</section>
