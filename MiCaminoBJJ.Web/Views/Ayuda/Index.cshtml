@{
    ViewData["Title"] = L["Ayuda.Titulo"];
}

<section class="mccj-page-header">
    <div class="container py-4 py-md-5">
        <span class="mccj-eyebrow">@L["Ayuda.Eyebrow"]</span>
        <h1 class="mccj-hero-title">@L["Ayuda.Titulo"]</h1>
        <p class="mccj-hero-description">
            @L["Ayuda.Descripcion"]
        </p>
    </div>
</section>

<section class="container mb-5">
    <div class="row g-4">
        <div class="col-12 col-lg-8">

            <nav class="mccj-ayuda-indice" aria-label="Contenido de la ayuda">
                <span class="mccj-ayuda-indice__label">@L["Ayuda.IndiceEtiqueta"]</span>
                <ul>
                    <li><a href="#que-es">@L["Ayuda.Indice.QueEs"]</a></li>
                    <li><a href="#registro">@L["Ayuda.Indice.Registro"]</a></li>
                    <li><a href="#biblioteca">@L["Ayuda.Indice.Biblioteca"]</a></li>
                    <li><a href="#cinturon">@L["Ayuda.Indice.Cinturon"]</a></li>
                    <li><a href="#videos">@L["Ayuda.Indice.Videos"]</a></li>
                    <li><a href="#guia">@L["Ayuda.Indice.Guia"]</a></li>
                    <li><a href="#perfil">@L["Ayuda.Indice.Perfil"]</a></li>
                    <li><a href="#faq">@L["Ayuda.Indice.Faq"]</a></li>
                    <li><a href="#roles">@L["Ayuda.Indice.Roles"]</a></li>
                </ul>
            </nav>

            <article class="mccj-ayuda-seccion" id="que-es">
                <h2 class="mccj-ayuda-seccion__titulo">@L["Ayuda.QueEs.Titulo"]</h2>
                <p>
                    @L["Ayuda.QueEs.P1"]
                </p>
                <p>
                    @L["Ayuda.QueEs.P2"]
                </p>
            </article>

            <article class="mccj-ayuda-seccion" id="registro">
                <h2 class="mccj-ayuda-seccion__titulo">@L["Ayuda.Registro.Titulo"]</h2>
                <ol class="mccj-ayuda-lista">
                    <li>
                        @L["Ayuda.Registro.L1"]
                    </li>
                    <li>
                        @L["Ayuda.Registro.L2"]
                    </li>
                    <li>
                        @L["Ayuda.Registro.L3"]
                    </li>
                    <li>
                        @L["Ayuda.Registro.L4"]
                        La sesión es de la aplicación: al cerrar el navegador se cierra también.
                    </li>
                    <li>
                        @L["Ayuda.Registro.L5"]
                    </li>
                </ol>
            </article>

            <article class="mccj-ayuda-seccion" id="biblioteca">
                <h2 class="mccj-ayuda-seccion__titulo">@L["Ayuda.Biblioteca.Titulo"]</h2>
                <p>
                    @L["Ayuda.Biblioteca.P1"]
                </p>
                <ul class="mccj-ayuda-lista">
                    <li>
                        @L["Ayuda.Biblioteca.L1"]
                    </li>
                    <li>
                        @L["Ayuda.Biblioteca.L2"]
                    </li>
                    <li>
                        @L["Ayuda.Biblioteca.L3"]
                    </li>
                </ul>
            </article>

            <article class="mccj-ayuda-seccion" id="cinturon">
                <h2 class="mccj-ayuda-seccion__titulo">@L["Ayuda.Cinturon.Titulo"]</h2>
                <ol class="mccj-ayuda-lista">
                    <li>
                        @L["Ayuda.Cinturon.L1"]
                    </li>
                    <li>
                        @L["Ayuda.Cinturon.L2"]
                    </li>
                    <li>
                        @L["Ayuda.Cinturon.L3"]
                    </li>
                </ol>
            </article>

            <article class="mccj-ayuda-seccion" id="videos">
                <h2 class="mccj-ayuda-seccion__titulo">@L["Ayuda.Videos.Titulo"]</h2>
                <ol class="mccj-ayuda-lista">
                    <li>@L["Ayuda.Videos.L1"]</li>
                    <li>
                        @L["Ayuda.Videos.L2"]
                    </li>
                    <li>
                        @L["Ayuda.Videos.L3"]
                    </li>
                </ol>
                <p class="mccj-ayuda-nota">
                    @L["Ayuda.Videos.Nota"]
                </p>
            </article>

            <article class="mccj-ayuda-seccion" id="guia">
                <h2 class="mccj-ayuda-seccion__titulo">@L["Ayuda.Guia.Titulo"]</h2>
                <p>
                    @L["Ayuda.Guia.P1"]
                </p>
                <ul class="mccj-ayuda-lista">
                    <li>
                        @L["Ayuda.Guia.L1"]
                    </li>
                    <li>
                        @L["Ayuda.Guia.L2"]
                    </li>
                    <li>
                        @L["Ayuda.Guia.L3"]
                    </li>
                    <li>
                        @L["Ayuda.Guia.L4"]
                    </li>
                </ul>
                <p class="mccj-ayuda-nota">
                    @L["Ayuda.Guia.Nota"]
                </p>
            </article>

            <article class="mccj-ayuda-seccion" id="perfil">
                <h2 class="mccj-ayuda-seccion__titulo">@L["Ayuda.Perfil.Titulo"]</h2>
                <p>
                    @L["Ayuda.Perfil.P1"]
                </p>
                <ul class="mccj-ayuda-lista">
                    <li>
                        @L["Ayuda.Perfil.L1"]
                    </li>
                    <li>
                        @L["Ayuda.Perfil.L2"]
                    </li>
                    <li>@L["Ayuda.Perfil.L3"]
                    </li>
                    <li>
                        @L["Ayuda.Perfil.L4"]
                    </li>
                    <li>
                        @L["Ayuda.Perfil.L5"]
                    </li>
                </ul>
                <p>
                    @L["Ayuda.Perfil.P2"]
                </p>
                <p class="mccj-ayuda-nota">
                    @L["Ayuda.Perfil.Nota"]
                </p>
            </article>

            <article class="mccj-ayuda-seccion" id="faq">
                <h2 class="mccj-ayuda-seccion__titulo">@L["Ayuda.Faq.Titulo"]</h2>
                <dl class="mccj-ayuda-faq">
                    <dt>@L["Ayuda.Faq.D1"]</dt>
                    <dd>@L["Ayuda.Faq.R1"]</dd>

                    <dt>@L["Ayuda.Faq.D2"]</dt>
                    <dd>@L["Ayuda.Faq.R2"]</dd>

                    <dt>@L["Ayuda.Faq.D3"]</dt>
                    <dd>@L["Ayuda.Faq.R3"]</dd>

                    <dt>@L["Ayuda.Faq.D4"]</dt>
                    <dd>@L["Ayuda.Faq.R4"]</dd>

                    <dt>@L["Ayuda.Faq.D5"]</dt>
                    <dd>@L["Ayuda.Faq.R5"]</dd>

                    <dt>@L["Ayuda.Faq.D6"]</dt>
                    <dd>@L["Ayuda.Faq.R6"]</dd>

                    <dt>@L["Ayuda.Faq.D7"]</dt>
                    <dd>@L["Ayuda.Faq.R7"]</dd>
                </dl>
            </article>

            <article class="mccj-ayuda-seccion" id="roles">
                <h2 class="mccj-ayuda-seccion__titulo">@L["Ayuda.Roles.Titulo"]</h2>
                <div class="table-responsive">
                    <table class="table mccj-ayuda-tabla">
                        <thead>
                            <tr>
                                <th scope="col">@L["Ayuda.Roles.Funcion"]</th>
                                <th scope="col">@L["Ayuda.Roles.Practicante"]</th>
                                <th scope="col">@L["Ayuda.Roles.Administrador"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <th scope="row">@L["Ayuda.Roles.Fila1"]</th>
                                <td>@L["Ayuda.Roles.Si"]</td>
                                <td>@L["Ayuda.Roles.Si"]</td>
                            </tr>
                            <tr>
                                <th scope="row">@L["Ayuda.Roles.Fila2"]</th>
                                <td>@L["Ayuda.Roles.Si"]</td>
                                <td>@L["Ayuda.Roles.Si"]</td>
                            </tr>
                            <tr>
                                <th scope="row">@L["Ayuda.Roles.Fila3"]</th>
                                <td>@L["Ayuda.Roles.Si"]</td>
                                <td>@L["Ayuda.Roles.Si"]</td>
                            </tr>
                            <tr>
                                <th scope="row">@L["Ayuda.Roles.Fila4"]</th>
                                <td>@L["Ayuda.Roles.No"]</td>
                                <td>@L["Ayuda.Roles.Panel"]</td>
                            </tr>
                            <tr>
                                <th scope="row">@L["Ayuda.Roles.Fila5"]</th>
                                <td>@L["Ayuda.Roles.No"]</td>
                                <td>@L["Ayuda.Roles.Panel"]</td>
                            </tr>
                            <tr>
                                <th scope="row">@L["Ayuda.Roles.Fila6"]</th>
                                <td>@L["Ayuda.Roles.No"]</td>
                                <td>@L["Ayuda.Roles.Panel"]</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
                <p class="mccj-ayuda-nota">
                    @L["Ayuda.Roles.Nota"]
                </p>
            </article>

        </div>

        <div class="col-12 col-lg-4">
            <div class="mccj-card mccj-card-dark mccj-ayuda-cta">
                <h3>@L["Ayuda.Cta.Titulo"]</h3>
                <p>
                    @L["Ayuda.Cta.P1"]
                </p>
                <div class="d-grid gap-2">
                    <a class="btn btn-gold" asp-controller="Tecnicas" asp-action="Index">@L["Ayuda.Cta.Biblioteca"]</a>
                    <a class="btn btn-outline-light" asp-controller="GuiaPracticante"
                       asp-action="Index">@L["Ayuda.Cta.Guia"]</a>
                </div>
            </div>
        </div>
    </div>
</section>
