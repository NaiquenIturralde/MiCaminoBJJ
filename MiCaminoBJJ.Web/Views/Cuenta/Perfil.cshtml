@model PerfilViewModel
@{
    ViewData["Title"] = L["Cuenta.Perfil.Titulo"];
}

<section class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-9 col-lg-7">

            <div class="mccj-auth-card">
                <div class="text-center mb-4">
                    <h1 class="mccj-auth-title">@L["Cuenta.Perfil.Titulo"]</h1>
                    <p class="mccj-auth-subtitle">@L["Cuenta.Perfil.Subtitulo"]</p>
                </div>

                @if (TempData["Exito"] is string exito)
                {
                    <div class="alert alert-success" role="status">@Mensajes.Traducir(L, exito)</div>
                }
                @if (TempData["Error"] is string error)
                {
                    <div class="alert alert-danger" role="alert">@Mensajes.Traducir(L, error)</div>
                }

                <form method="post" asp-controller="Cuenta" asp-action="Perfil" enctype="multipart/form-data"
                      novalidate>
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

                    @* ── Fotografía de perfil (120 × 120, esquinas redondeadas) ── *@
                    <div class="mccj-profile-photo-block">
                        <div class="mccj-profile-photo" role="img"
                             aria-label="@(string.IsNullOrEmpty(Model.FotoUrl) ? L["Cuenta.Perfil.AvatarIniciales"] : L["Cuenta.Perfil.TuFoto"])">
                            @if (!string.IsNullOrEmpty(Model.FotoUrl))
                            {
                                <img src="@Model.FotoUrl" class="mccj-profile-photo__img" alt="@L["Cuenta.Perfil.TuFoto"]"
                                     width="120" width="120" height="120" />
                            }
                            else
                            {
                                <span class="mccj-profile-photo__iniciales" aria-hidden="true">@Model.Iniciales</span>
                            }
                        </div>

                        <div class="mccj-profile-photo-block__datos">
                            <label class="form-label" for="foto">@L["Cuenta.Perfil.Foto"]</label>
                            <input type="file" id="foto" name="foto" class="form-control"
                                   accept="image/jpeg,image/png,image/webp" />
                            <small class="form-text text-muted">
                                @L["Cuenta.Perfil.FotoAyuda"]
                            </small>
                            @* El error de la foto no es una propiedad del modelo: se muestra a mano. *@
                            @if (ViewData.ModelState["foto"] is { Errors.Count: > 0 } errorFoto)
                            {
                                <span class="text-danger d-block">@errorFoto.Errors[0].ErrorMessage</span>
                            }
                        </div>
                    </div>

                    @* ── Nombre ── *@
                    <div class="mb-3">
                        <label asp-for="Nombre" class="form-label">@L["Common.Nombre"]</label>
                        <input asp-for="Nombre" class="form-control" maxlength="100"
                               placeholder="@L["Cuenta.Perfil.NombrePlaceholder"]" autocomplete="name" />
                        <span asp-validation-for="Nombre" class="text-danger"></span>
                    </div>

                    @* ── Cinturón (solo valores del catálogo) ── *@
                    <div class="mb-3">
                        <span class="form-label d-block" id="ayudaCinturon">@L["Cuenta.Perfil.CinturonActual"]</span>
                        <p class="mccj-belt-field-hint" id="ayudaCinturonTexto">
                            @L["Cuenta.Registro.CinturonAyuda"]
                        </p>
                        <div class="mccj-belt-picker" role="radiogroup" aria-label="@L["Cuenta.Perfil.CinturonActual"]"
                             aria-describedby="ayudaCinturonTexto">
                            @foreach (var opcion in Model.OpcionesCinturon)
                            {
                                <label class="mccj-belt-option @opcion.Clase">
                                    <input type="radio" asp-for="Cinturon" value="@opcion.Valor"
                                           id="perfil-cinturon-@opcion.Slug" class="mccj-belt-option__input" />
                                    <img src="@Url.Content(opcion.Imagen)" alt="" class="mccj-belt-option__img" width="72"
                                         height="72" />
                                    <span class="mccj-belt-option__name">@opcion.Etiqueta</span>
                                </label>
                            }
                        </div>
                        <span asp-validation-for="Cinturon" class="text-danger d-block"></span>
                    </div>

                    @* ── Datos de solo lectura ── *@
                    <dl class="mccj-profile-data">
                        <div class="mccj-profile-data__row">
                            <dt>@L["Common.Email"]</dt>
                            <dd>@Model.Email</dd>
                        </div>
                        <div class="mccj-profile-data__row">
                            <dt>@L["Common.Rol"]</dt>
                            <dd><span class="mccj-badge">@Model.Rol</span></dd>
                        </div>
                        <div class="mccj-profile-data__row">
                            <dt>@L["Cuenta.Perfil.MiembroDesde"]</dt>
                            <dd>@Model.MiembroDesde.ToLocalTime().ToString("dd/MM/yyyy")</dd>
                        </div>
                    </dl>

                    <p class="mccj-profile-note">
                        @L["Cuenta.Perfil.Nota"]
                    </p>

                    <div class="d-grid gap-2 mt-4">
                        <button type="submit" class="btn btn-gold">@L["Cuenta.Perfil.GuardarCambios"]</button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
