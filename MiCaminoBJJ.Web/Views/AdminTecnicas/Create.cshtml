@using MiCaminoBJJ.Web.ViewModels.Admin
@model AdminTecnicaFormViewModel
@{
    ViewData["Title"] = L["Admin.Titulo.Nueva"];
}
<partial name="_EstilosAdmin" />

<section class="mccj-page-header">
    <div class="container py-4 py-md-5">
        <span class="mccj-eyebrow">@L["Admin.Eyebrow.Crear"]</span>
        <h1 class="mccj-hero-title">@L["Admin.Titulo.Nueva"]</h1>
        <p class="mccj-hero-description">
            @L["Admin.Descripcion.Nueva"]
        </p>
    </div>
</section>

<section class="container mt-4 mb-5">
    <partial name="_FormularioTecnica" model="Model" />
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
