@using MiCaminoBJJ.Web.ViewModels.Admin
@model AdminTecnicaFormViewModel
@{
    ViewData["Title"] = L["Admin.Titulo.Editar"];
}
@* Estilos del reproductor reutilizados (selectores solo con prefijo mccjrc-):
   miniaturas 16:9 e iframe del reproductor de la sección multimedia. *@
<link rel="stylesheet" href="~/css/recorrido.css" asp-append-version="true" />
<partial name="_EstilosAdmin" />

<section class="mccj-page-header">
    <div class="container py-4 py-md-5">
        <span class="mccj-eyebrow">@L["Admin.Eyebrow.Editar"]</span>
        <h1 class="mccj-hero-title">@Model.Nombre</h1>
        <p class="mccj-hero-description">
            @L["Admin.Descripcion.Editar"]
        </p>
    </div>
</section>

<section class="container mt-4 mb-5">
    @* Mensajes de las acciones multimedia (redirect PRG desde AdminTecnicasMedia). *@
    @if (TempData["Exito"] is string exito)
    {
        <div class="alert mccj-admin-alert-ok" role="status">@exito</div>
    }
    @if (TempData["Error"] is string error)
    {
        <div class="alert mccj-admin-alert-err" role="alert">@error</div>
    }

    <partial name="_FormularioTecnica" model="Model" />

    @* Sección multimedia: solo en edición (Create no tiene técnica aún). *@
    @if (Model.Multimedia is not null)
    {
        <partial name="_MultimediaTecnica" model="Model.Multimedia" />
    }
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (Model.Multimedia?.TieneVideoIntegrado == true)
    {
        @* Reproductor diferido compartido: el iframe se crea recién al pulsar
           Play (sin autoplay en el HTML, sin descargas en el servidor). *@
        <script src="~/js/recorrido-video.js" asp-append-version="true"></script>
    }
}
